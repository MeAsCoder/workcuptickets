# ----------------------------------------------------------------------------
# DATABASE (PostgreSQL — e.g. Neon / Vercel Postgres)
# Local dev + one-time seeding read these. On Vercel, the Neon integration
# already provides DATABASE_URL and DATABASE_URL_UNPOOLED automatically.
#
# DATABASE_URL          = pooled connection   (used by the running app)
# DATABASE_URL_UNPOOLED = direct connection   (used by `prisma db push` / seeding)
# Get both strings from Vercel → Storage → your database → ".env.local" tab,
# or run:  vercel env pull .env
# ----------------------------------------------------------------------------
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require"

# AUTH
JWT_SECRET="change-me-to-a-long-random-string"

# PUBLIC SITE CONFIG
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_WHATSAPP_NUMBER="+15551234567"

# SEED ADMIN (created by `node prisma/seed.mjs`)
ADMIN_EMAIL="admin@worldcuptickets.test"
ADMIN_PASSWORD="admin1234"

# EMAIL (optional — leave blank to log emails to the console instead)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="tickets@worldcuptickets.test"
